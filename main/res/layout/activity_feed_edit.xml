<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/back_tool"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/edit_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="订阅源规则"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/edit_test"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="6dp"
            android:background="@drawable/btn_selector"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="测试"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/edit_save"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_selector"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="保存"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="40dp">

            <TextView style="@style/FeedEditLabel" android:text="名称" />
            <EditText android:id="@+id/et_name" style="@style/FeedEditInput" android:hint="留空则用地址" />

            <TextView style="@style/FeedEditLabel" android:text="分组" />
            <EditText android:id="@+id/et_group" style="@style/FeedEditInput" android:hint="可选，例如 技术" />

            <TextView style="@style/FeedEditLabel" android:text="订阅地址" />
            <EditText android:id="@+id/et_url" style="@style/FeedEditInput" android:hint="https://example.com/feed" android:inputType="textUri" />

            <TextView style="@style/FeedEditLabel" android:text="请求头 Header（JSON）" />
            <EditText android:id="@+id/et_header" style="@style/FeedEditInput"
                android:hint="{&quot;User-Agent&quot;:&quot;...&quot;}" />

            <TextView style="@style/FeedEditLabel" android:text="栏目规则 ruleArticles" />
            <EditText android:id="@+id/et_articles" style="@style/FeedEditInput"
                android:hint="CSS 选择器，如 .post-list li；留空则按 RSS/Atom 解析" />

            <TextView style="@style/FeedEditLabel" android:text="标题 ruleTitle" />
            <EditText android:id="@+id/et_title" style="@style/FeedEditInput" android:hint="a 或 .title" />

            <TextView style="@style/FeedEditLabel" android:text="链接 ruleLink" />
            <EditText android:id="@+id/et_link" style="@style/FeedEditInput" android:hint="a@href" />

            <TextView style="@style/FeedEditLabel" android:text="时间 rulePubDate" />
            <EditText android:id="@+id/et_date" style="@style/FeedEditInput" android:hint=".date@text" />

            <TextView style="@style/FeedEditLabel" android:text="摘要 ruleDescription" />
            <EditText android:id="@+id/et_desc" style="@style/FeedEditInput" android:hint=".summary@text" />

            <TextView style="@style/FeedEditLabel" android:text="图片 ruleImage" />
            <EditText android:id="@+id/et_image" style="@style/FeedEditInput" android:hint="img@src" />

            <TextView style="@style/FeedEditLabel"
                android:text="正文 ruleContent（支持 @@css: / @js: 前缀）" />
            <EditText android:id="@+id/et_content" style="@style/FeedEditInput"
                android:layout_height="110dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:hint="@css:.article-body&#10;@@css:.post-content&#10;@js:document.querySelector('.entry').innerHTML" />

            <TextView style="@style/FeedEditLabel" android:text="下一页 ruleNextPage" />
            <EditText android:id="@+id/et_nextpage" style="@style/FeedEditInput" android:hint=".next@href（预留，暂不翻页）" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="启用该订阅源"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cb_enabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/edit_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="规则语法：CSS 选择器可直接写；@css: / @@css: 表示取该元素 HTML；@js: 在页面上下文执行 JS，返回字符串或元素。"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
