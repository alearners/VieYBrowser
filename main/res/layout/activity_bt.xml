<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal">
        <ImageView android:id="@+id/bt_back_btn" android:layout_width="40dp" android:layout_height="40dp"
            android:padding="8dp" android:src="@drawable/ic_arrow_back" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center_vertical" android:paddingStart="8dp"
            android:text="BT 下载（magnet / .torrent）" android:textColor="@color/text_primary" android:textSize="15sp" />
    </LinearLayout>

    <EditText android:id="@+id/bt_input" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="magnet:?xt=urn:btih:… 或 .torrent 文件路径 / 下载地址；每行一个" android:textSize="11sp"
        android:minLines="3" android:gravity="top" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/bt_pick" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="选择 .torrent" android:textSize="12sp" />
        <Button android:id="@+id/bt_selftest" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="BT 自检" android:textSize="12sp" />
        <Button android:id="@+id/bt_start" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="开始" android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/bt_pause" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="暂停（piece 续传）" android:textSize="12sp" />
        <Button android:id="@+id/bt_open" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="下载目录" android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar android:id="@+id/bt_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="8dp" android:max="100" android:progress="0" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:id="@+id/bt_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="12dp" android:textIsSelectable="true" android:textSize="11sp"
            android:textColor="@color/text_secondary" android:text="等待操作" />
    </ScrollView>
</LinearLayout>
