<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal">
        <ImageView android:id="@+id/back_tool" android:layout_width="40dp" android:layout_height="40dp"
            android:padding="8dp" android:src="@drawable/ic_arrow_back" />
        <TextView android:id="@+id/plugin_title" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="8dp"
            android:text="用户脚本插件" android:textColor="@color/text_primary" android:textSize="15sp" />
        <ImageView android:id="@+id/plugin_market" android:layout_width="40dp" android:layout_height="40dp"
            android:padding="8dp" android:src="@drawable/ic_share" />
        <ImageView android:id="@+id/plugin_add" android:layout_width="40dp" android:layout_height="40dp"
            android:padding="8dp" android:src="@drawable/ic_add" />
    </LinearLayout>

    <EditText android:id="@+id/plugin_input" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="粘贴 .user.js 脚本内容，或填写脚本地址后点 +" android:textSize="11sp"
        android:minLines="2" android:gravity="top" />

    <TextView android:id="@+id/plugin_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="16dp" android:textColor="@color/text_secondary" android:textSize="11sp"
        android:text="还没有插件。点右上角 + 从地址导入，或粘贴脚本后点 +。市场地址可在设置里改。" />

    <ListView android:id="@+id/plugin_list" android:layout_width="match_parent" android:layout_height="match_parent"
        android:divider="@null" />
</LinearLayout>
