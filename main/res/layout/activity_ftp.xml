<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/back_tool"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="FTP / SMTP 工具（移植 Vie 6.5.0 commons-net）"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <EditText android:id="@+id/ftp_host" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="主机，如 ftp.example.com" android:textSize="12sp" />
    <EditText android:id="@+id/ftp_user" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="用户名（匿名可填 anonymous）" android:textSize="12sp" />
    <EditText android:id="@+id/ftp_pass" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="密码" android:inputType="textPassword" android:textSize="12sp" />
    <EditText android:id="@+id/ftp_path" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="目录，留空为 /" android:textSize="12sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/ftp_list" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="列出目录" android:textSize="12sp" />
        <Button android:id="@+id/ftp_download" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="下载选中" android:textSize="12sp" />
    </LinearLayout>

    <TextView android:id="@+id/ftp_state" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:text="未连接"
        android:textColor="@color/text_secondary" android:textSize="11sp" />

    <ListView android:id="@+id/ftp_list_view" android:layout_width="match_parent" android:layout_height="match_parent"
        android:divider="@null"
        android:choiceMode="singleChoice" />
</LinearLayout>
